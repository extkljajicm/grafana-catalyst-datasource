# ===================================================================
# Comprehensive .gitignore with a focus on security and best practices
# Merged from multiple standard sources and security recommendations.
# ===================================================================

# -------------------------------------------------------------------
# Security - Credentials & Secrets (CRITICAL) 🛡️
# NEVER commit secrets, private keys, API keys, or credentials.
# -------------------------------------------------------------------

# Environment variables
# Often contain database passwords, API keys, and other secrets.
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.template

# Private keys, certificates, and access files
*.pem
*.key
*.p12
*.pfx
*.jks
*.ppk
*.keystore
.htpasswd
.htaccess

# SSH client data
id_rsa
id_dsa
id_ecdsa
id_ed25519
ssh_config
known_hosts

# GPG
secring.*
*.gnupg

# Generic credential files
secrets.*
credentials.*
config.json
settings.json
*.properties

# Cloud provider credentials & state files
.aws/
.boto
.gcloud/
.azure/
terraform.tfstate*
.terraform.lock.hcl

# Application-specific secret files
google-services.json
client_secret.json
serviceAccountKey.json

# Shell history files (can contain typed-in passwords)
.bash_history
.zsh_history
.history

---

# -------------------------------------------------------------------
# Logs, Databases & Runtime Data
# Can contain sensitive user data, system info, or temporary state.
# -------------------------------------------------------------------
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.prof

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Databases
*.sql
*.sqlite
*.sqlite3
*.dump
*.rdb

---

# -------------------------------------------------------------------
# Dependency Directories
# These should be installed by a package manager, not stored in git.
# -------------------------------------------------------------------
node_modules/
vendor/
bower_components/
jspm_packages/

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

---

# -------------------------------------------------------------------
# Build, Compilation & Packaging Output ⚙️
# Generated artifacts that don't need to be versioned.
# -------------------------------------------------------------------
dist/
build/
out/
bin/
target/
artifacts/
work/
ci/
release/
*.zip

# Compiled files
*.o
*.a
*.so
*.node
*.class
*.jar
*.war
*.ear
*.exe
*.dll
*.dylib
*.test
*.out

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Go
.magefile

# Grafana
.grafana-*

---

# -------------------------------------------------------------------
# Testing & Coverage Reports
# Generated during test runs.
# -------------------------------------------------------------------
coverage/
lib-cov/
.nyc_output/
.eslintcache

# E2E / Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

---

# -------------------------------------------------------------------
# IDE & Editor Directories
# -------------------------------------------------------------------

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# JetBrains (IntelliJ, PyCharm, etc.)
.idea/

# Vim / Neovim
*.swp
*.swo

---

# -------------------------------------------------------------------
# Containerization 🐳
# -------------------------------------------------------------------
# Local Docker Compose overrides can contain secrets or local paths.
docker-compose.override.yml

---

# -------------------------------------------------------------------
# OS-Specific Files
# -------------------------------------------------------------------

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
*:Zone.Identifier

---

# Docker
docker-compose.override.yml

# Copilot
.github/copilot-instructions.md

# -------------------------------------------------------------------
# General Backup & Temporary Files
# -------------------------------------------------------------------
*.bak
*.gho
*.ori
*.orig
*.tmp
*.rej
